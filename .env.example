# Copier en .env.local et remplir avec les vraies valeurs (jamais commité)

# Dashboard Supabase > Project Settings > API — clés publiques uniquement,
# jamais la clé secret ici (celle-là reste dans musicAPI/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# musicAPI en local
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Vie privée : écran d'accueil « âge + conditions » (désactivé par défaut) ---
# À n'activer qu'une fois la politique de confidentialité et les conditions PUBLIÉES : l'écran
# renvoie vers elles. Les migrations de l'API (consents) doivent être appliquées d'abord.
# PRIVACY_GATE=on
# Étiquette de la version du texte affiché (ex. 2026-10). Un nouveau texte = une nouvelle
# étiquette : tout le monde doit alors l'accepter de nouveau.
# PRIVACY_POLICY_VERSION=2026-10
# PRIVACY_POLICY_URL=https://…/privacy
# TERMS_URL=https://…/terms
# Adresse pour exercer ses droits (accès, rectification, export, suppression).
# PRIVACY_CONTACT_EMAIL=privacy@…

# --- Abonnement payant (désactivé par défaut) ---
# « on » pour montrer « Go Premium » / « Manage subscription » dans les réglages. À n'activer que
# quand l'API est reliée à Stripe (voir le README de l'admin) : sinon personne ne doit voir de
# bouton de paiement.
# BILLING_UI=on
